# AgentsMind core settings. Copy to .env (same folder) and fill in.
# .env is gitignored. Never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite by default. For PostgreSQL install requirements/postgres.txt and use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentsmind
# DATABASE_URL defaults to sqlite:///<repo>/data/agentsmind.db

# Required. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# First run only: creates the first admin when no users exist.
# Password must be 12+ characters and not contain the email name.
AGENTSMIND_ADMIN_EMAIL=
AGENTSMIND_ADMIN_PASSWORD=

TIMEZONE=Asia/Karachi
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Work queue: db (durable, use this) or memory (tests/demos only; a separate worker cannot see it)
QUEUE_BACKEND=db
QUEUE_LEASE_SECONDS=60
QUEUE_BACKOFF_SECONDS=2
QUEUE_MAX_ATTEMPTS=3

# Sample data (synthetic users, inbox, CVs, calendar, portal records). false = your real data only.
DEMO_MODE=false

# Empty = sandbox: agent output is labeled Simulated and rules/templates are used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── External systems (separate apps, separate databases) ──────────────────────
FINANCE_PORTAL_API_KEY=
FINANCE_PORTAL_SECRET_KEY=
FINANCE_PORTAL_ADMIN_EMAIL=
FINANCE_PORTAL_ADMIN_PASSWORD=
# FINANCE_PORTAL_DB_URL defaults to sqlite:///<repo>/data/finance_portal.db

IT_PORTAL_API_KEY=
IT_PORTAL_SECRET_KEY=
IT_PORTAL_ADMIN_EMAIL=
IT_PORTAL_ADMIN_PASSWORD=
IT_PORTAL_PUBLIC_URL=http://127.0.0.1:8202
# IT_PORTAL_DB_URL defaults to sqlite:///<repo>/data/it_portal.db

# ── MCP servers (bound to 127.0.0.1; each needs its bearer token) ─────────────
FINANCE_MCP_TOKEN=
FINANCE_MCP_PORT=8101
FINANCE_MCP_URL=http://127.0.0.1:8101/mcp
FINANCE_PORTAL_URL=http://127.0.0.1:8201
IT_MCP_TOKEN=
IT_MCP_PORT=8102
IT_MCP_URL=http://127.0.0.1:8102/mcp
IT_PORTAL_URL=http://127.0.0.1:8202

CALENDAR_MCP_TOKEN=
CALENDAR_MCP_PORT=8103
CALENDAR_MCP_URL=http://127.0.0.1:8103/mcp
WORKSPACE_MCP_TOKEN=
WORKSPACE_MCP_PORT=8104
WORKSPACE_MCP_URL=http://127.0.0.1:8104/mcp
# workspace-mcp calls the core's /api/internal/status with WORKSPACE_MCP_TOKEN (queue_stats, agent_status)
CORE_API_URL=http://127.0.0.1:8000

# ── Gmail by app password (IMAP/SMTP): Google Account > Security > App passwords ──
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# ── WhatsApp through Twilio ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886 (Twilio sandbox number); TO is the default recipient
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
# Optional WhatsApp template (Content SID) for messages outside the 24-hour window
TWILIO_CONTENT_SID=

# ── HR files on this computer ─────────────────────────────────────────────────
# Folders (separated by ;) with HR Excel sheets and with CVs. data\hr_sheets and data\cvs are always included.
HR_EXCEL_DIRS=
HR_CV_DIRS=

# ── Google (Calendar, Drive, Sheets; Gmail too if no app password): one OAuth client ──
# auto = Google once you signed in (main.py or Settings > Connections), otherwise a local calendar.
CALENDAR_MODE=auto
WORKSPACE_MODE=auto
# Desktop-app OAuth client JSON from Google Cloud Console (secrets/ is gitignored)
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
# Encrypts data/google_token.enc. Changing it means signing in again.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Public link (main.py --public / Start-Public-Link.bat). Leave empty for a free Quick Tunnel with a new
# random https://...trycloudflare.com address each start. For a fixed address: create a tunnel in the
# Cloudflare dashboard (needs a domain on your Cloudflare account) and paste its token and public address here.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=
