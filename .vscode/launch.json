{
  // Run and Debug (Ctrl+Shift+D): pick one of these and press F5.
  // "Run AgentsMind" starts everything, including the Finance Portal and IT Helpdesk.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AgentsMind",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run AgentsMind without the external systems",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--no-portals"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run External Systems (Finance Portal, IT Helpdesk)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/external_systems/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run all tests (report in logs/test-report.txt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_tests.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Check Gmail connection (report in logs/gmail-check.txt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_gmail.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Stop AgentsMind",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--stop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
